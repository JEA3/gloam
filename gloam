def configured_timezone():
    """Get the configured IANA zone from the process or common Unix files."""
    zone = os.environ.get("TZ")
    if zone:
        return zone.lstrip(":")
    # On Linux and macOS, /etc/localtime is often a link into zoneinfo.
    path = os.path.realpath("/etc/localtime")
    if "/zoneinfo/" in path:
        return path.split("/zoneinfo/", 1)[1]
    try:
        with open("/etc/timezone", encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def english_region():
    """Unknown and non-US zones retain gloam's original British spelling."""
    return "US" if configured_timezone() in US_TIMEZONES else "GB"


def english_word(british, american, region):
